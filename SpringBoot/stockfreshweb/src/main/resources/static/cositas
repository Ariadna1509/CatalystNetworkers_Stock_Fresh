/* ===== Navegación ===== */
function actualizarNav(logueado) {
    sesionActiva = logueado;

    for (const [id, ruta] of Object.entries(RUTAS_NAV)) {
        const link = document.getElementById(id);
        if (!link) continue;

        // Guarda el href original del HTML (página informativa) la primera vez
        if (link.hasAttribute('href') && !link.dataset.hrefInfo) {
            link.dataset.hrefInfo = link.getAttribute('href');
        }

        link.classList.remove('nav-disabled');
        link.removeAttribute('aria-disabled');

        if (logueado) {
            // Con sesión: sin href, el listener carga la vista en .principal
            link.removeAttribute('href');
            link.style.cursor = 'pointer';
        } else {
            // Sin sesión: se restaura el href del HTML (página informativa)
            if (link.dataset.hrefInfo) {
                link.setAttribute('href', link.dataset.hrefInfo);
            }
            link.style.cursor = '';
        }
    }

    const login = document.getElementById('button-login-dom');
    if (login) login.style.display = logueado ? 'none' : '';
}

function irHome() {
    if (sesionActiva) {
        cargarDashBoard();
    } else {
        cargarMain();
    }
}

async function cargarDashBoard() { 
    try {
        await cargarVista('dashBoard.html');
        actualizarNav(true);
    } catch (e) {
        console.error('No se pudo cargar el dashboard', e);
    }
}

async function verificarSesion() {
    actualizarNav(false); // estado seguro mientras responde el backend
    try {
        const r = await fetch(API_BASE + '/api/locatarios/me', { credentials: 'include' });
        actualizarNav(r.ok);
    } catch (e) {
        actualizarNav(false);
    }
}

/* Clicks del nav: carga la vista dentro de .principal (igual que el dashboard).
   Se usa captura + preventDefault para que NUNCA se navegue a Caja.html,
   aunque otro script le haya puesto un href al enlace. */
document.addEventListener('click', (e) => {
    const link = e.target.closest('.header-nav a');
    if (!link) return;

    // Sin sesión: deja que el enlace navegue normal a su href informativo
    if (!sesionActiva) return;

    const ruta = RUTAS_NAV[link.id];
    if (!ruta) return;

    e.preventDefault();
    cargarVista(ruta).catch(err => console.error('Error:', err));
}, true);

document.addEventListener('DOMContentLoaded', verificarSesion);